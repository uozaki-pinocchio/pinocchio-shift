rules_version = '2';
// Firebase のセキュリティルール。
// Firebase 管理画面の「Firestore Database」→「ルール」にこの中身を貼り付けて「公開」する。
// 貼り付けるときに、下の「ここに…」を実際のメールアドレスに書き換える。
// （アドレスを公開しないため、このファイルには書かないでおく）
service cloud.firestore {
  match /databases/{database}/documents {
    // 管理者（共通アカウント）は全部読み書きできる
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "ここに共通アカウントのメールアドレス";
    }
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // スタッフ用ページ：合言葉（リンクに入っている長い文字列）を知っている人だけが、その1件を読める。
    // 一覧を取ることはできないので、他の人の合言葉は分からない。
    match /portals/{token} {
      allow get: if true;
    }

    // スタッフが出す希望：自分の合言葉の分だけ、決まった形でしか書けない
    match /submissions/{id} {
      allow get: if true;
      allow create, update: if
        request.resource.data.keys().hasOnly(['token', 'ym', 'days', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.ym is string
        && request.resource.data.ym.matches('[0-9]{4}-[0-9]{2}')
        && id == request.resource.data.token + '_' + request.resource.data.ym
        && request.resource.data.days is map
        && request.resource.data.days.size() <= 31
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/portals/$(request.resource.data.token));
    }
  }
}
